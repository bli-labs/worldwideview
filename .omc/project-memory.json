  "build": {
    "buildCommand": "git add -A && git status --short | grep -v '.omc' && git commit -q -m \"feat(voice): switch the voice agent to Gemini Live (self-hosted brain)\n\nReplaces the ElevenLabs backend. The agent's persona and tools now live\nentirely in this codebase — no third-party dashboard, so the agent can\nnever drift back to an unrelated config. Uses the GEMINI_API_KEY the\noperator already holds.\n\n- /api/agent/voice-token: session-authed minting of single-use Gemini\n  ephemeral tokens (30-min cap); GEMINI_API_KEY stays server-side. GET\n  reports { configured } so the overlay only renders the orb when the\n  backend is ready.\n- VoiceAgentHandler: Gemini Live session (gemini-2.5-flash native audio),\n  MCP tools registered as function declarations, input/output\n  transcription → transcript panel, audio-input pause during tool calls,\n  1008/1011 auto-reconnect. liveAudio.ts: 16kHz mic worklet capture +\n  24kHz scheduled playback with level metering. persona.ts: SpatialCore\n  operator prompt + voice + model, all in-repo.\n- McpToolBridge, orb UI, transcript panel unchanged — tools still\n  discovered live from the WWV MCP surface.\n- Removed @elevenlabs/client, scripts/setup-voice-agent.mjs; added\n  @google/genai. Docs rewritten: one env var (GEMINI_API_KEY).\n\nVerified live: orb → CONNECTING → LISTENING, clean console (token\nminted, Live socket connected, mic acquired). pnpm test 1031 passed,\npnpm build green, voice files lint clean.\" && git push git@github.com:bli-labs/worldwideview.git main 2>&1 | tail -2 && git fetch origin 2>&1 | tail -1",
    "testCommand": "export PATH=\"$HOME/.nvm/versions/node/v24.16.0/bin:$PATH\" && pnpm test 2>&1 | tail -8",
    "lintCommand": "pnpm lint",
    "devCommand": "pnpm dev",
    "scripts": {
      "setup": "node scripts/setup.mjs",
      "test-worktree": "node scripts/test-worktree.mjs",
      "clean": "node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true})\"",
      "dev": "node scripts/dev.mjs",
      "dev:all": "concurrently -n \"dev,backends\" -c \"magenta,blue\" \"pnpm dev\" \"pnpm dev:backends\"",
      "dev:backends": "docker compose --profile engine up wwv-data-engine wwv-redis",
      "dev:plugins": "node scripts/watch-local-plugins.mjs",
      "predev": "node scripts/boot-db.mjs && npx dotenv-cli -c -- node scripts/safe-db-push.mjs && npx prisma generate && node scripts/copy-cesium.mjs && node scripts/sync-local-plugins.mjs",
      "copy-cesium": "node scripts/copy-cesium.mjs",
      "prebuild": "node scripts/check-build-env.mjs",
      "build": "next build --webpack",
      "start": "next start",
      "test": "vitest run",
      "test:e2e": "playwright test",
      "test:mutate": "stryker run",
      "lint": "eslint .",
      "db:reset": "npx prisma migrate reset --force",
      "db:prune": "node scripts/db-prune.mjs",
      "generate": "prisma generate"
    }
  },
